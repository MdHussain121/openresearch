# OpenResearch Monorepo Root Environment Configuration
# Copy this file to .env for local Docker Compose or full-stack development.

# Environment
ENVIRONMENT=development

# Web Frontend Port & API URL
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend API Port & Security
API_PORT=8000
SECRET_KEY=<generate-a-random-secret-at-least-32-characters-long>

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=openresearch
POSTGRES_PASSWORD=<your-database-password>
POSTGRES_DB=openresearch
DATABASE_URL=postgresql://openresearch:<your-database-password>@localhost:5432/openresearch

# Redis
REDIS_URL=redis://localhost:6379/0

# Web Dev Origins allowed by Next.js dev server (comma-separated, optional)
ALLOWED_DEV_ORIGINS=

# Storage
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50

# External Services
GROBID_HOST=http://grobid:8070
OLLAMA_HOST=http://ollama:11434

# Tabby local autocomplete server (keyless; inline autocomplete only)
# NOTE: avoid port 8080 - desktop apps (e.g. Steam's debug server) often claim it.
# Off by default - enable it from Settings > AI Autocomplete in the app.
TABBY_BASE_URL=http://127.0.0.1:9090
TABBY_MODEL=Qwen2.5-Coder-1.5B
TABBY_AUTOCOMPLETE_ENABLED=false
