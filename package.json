{
  "name": "openresearch-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-Source AI Academic Research & Writing Assistant",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "package:desktop": "npm run package:win --workspace=apps/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "cd apps/api && .venv/Scripts/ruff.exe format --check app tests",
    "format": "cd apps/api && .venv/Scripts/ruff.exe format app tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "openresearch",
    "academic-writing",
    "ai-research",
    "citations",
    "tiptap",
    "nextjs",
    "fastapi"
  ],
  "author": "OpenResearch Contributors",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^20.12.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  }
}
