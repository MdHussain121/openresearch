# OpenResearch Self-Hosting Environment Configuration
# Copy this file to .env.selfhost and adjust values for your environment.

# -----------------
# Network & Ports
# -----------------
WEB_PORT=3000
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# -----------------
# Security & Auth
# -----------------
# The values below are auto-generated by install.sh / install.ps1 when they
# create .env.selfhost. Do NOT run with these placeholder values in production -
# the default SECRET_KEY is rejected by the application in all environments.
SECRET_KEY=generate_a_random_32_character_secret_key_here_for_production
REDIS_PASSWORD=generate_a_random_password_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------
# Database (Postgres with pgvector)
# -----------------
POSTGRES_USER=openresearch
POSTGRES_PASSWORD=replace_with_a_secure_db_password
POSTGRES_DB=openresearch

# -----------------
# AI & Provider Settings (Local First)
# -----------------
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# -----------------
# GROBID PDF Parsing
# -----------------
GROBID_HOST=http://localhost:8070

# -----------------
# Storage Directory
# -----------------
UPLOAD_DIR=./storage/uploads
