# OpenResearch Backend API Configuration
# Copy this file to .env and adjust variables as necessary for your deployment.

# Application Environment (development | production | test)
ENVIRONMENT=development

# Security — auth removed, app is offline local-first.
# SECRET_KEY kept for backwards compat (ephemeral, auto-generated if missing)
# SECRET_KEY=deprecated
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Deprecated: OPENRESEARCH_DEV_INSECURE_AUTH no longer needed (auth removed)
# OPENRESEARCH_DEV_INSECURE_AUTH=0

# Database Connection (SQLite default for dev, PostgreSQL with pgvector for prod)
DATABASE_URL=sqlite:///./openresearch_dev.db
# DATABASE_URL=postgresql://openresearch:openresearch_dev_password@localhost:5432/openresearch

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (JSON array format required by pydantic-settings)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File Storage Configuration
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50

# GROBID PDF Full-Text Extraction Service
GROBID_URL=http://localhost:8070
GROBID_HOST=http://localhost:8070

# LLM & Embedding Service Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Tabby local autocomplete server (keyless; used only for inline autocomplete)
# Off by default - enable it from Settings > AI Autocomplete in the app.
TABBY_BASE_URL=http://localhost:8080
TABBY_MODEL=Qwen2.5-Coder-1.5B
TABBY_AUTOCOMPLETE_ENABLED=false

# LLM Performance Settings
LLM_TIMEOUT_SECONDS=20
LLM_MAX_CONTEXT_CHARS=12000
LLM_MAX_TOKENS=1200

# Plugin Settings (comma-separated importable module prefixes)
PLUGIN_ALLOWED_MODULE_PREFIXES=app/plugins.

# Rate Limiting — deprecated (auth removed, kept for compat)
# LOGIN_RATE_LIMIT_MAX_REQUESTS=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# REGISTER_RATE_LIMIT_MAX_REQUESTS=20
# REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
