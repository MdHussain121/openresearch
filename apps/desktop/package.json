{
  "name": "@openresearch/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build:ts": "esbuild src/main.ts src/preload.ts --outdir=dist --bundle --platform=node --target=node20 --external:electron",
    "build": "npm run build:ts",
    "typecheck": "tsc --noEmit",
    "start": "electron dist/main.js",
    "dev": "npm run build:ts && electron dist/main.js",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.3.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.5"
  }
}
