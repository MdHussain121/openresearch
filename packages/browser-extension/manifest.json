{
  "manifest_version": 3,
  "name": "OpenResearch — Save to Library",
  "version": "1.0.1",
  "description": "Capture academic papers, preprints, and DOIs directly into your OpenResearch library.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to OpenResearch"
  }
}
